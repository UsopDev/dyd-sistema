# Variables del backend.
# Copiar a `.env` y completar los valores reales. No versionar `.env`.

NODE_ENV=development
PORT=3000

# Estas URLs son para correr el backend en el host (`npm run dev`).
# Docker Compose las reemplaza automáticamente por `postgres:5432` y `redis:6379`.
DATABASE_URL=postgresql://dyd:cambia-esta-password@localhost:5433/dyd_db?schema=public
REDIS_URL=redis://localhost:6379

# Mínimo 32 caracteres. Generar con: openssl rand -base64 48
JWT_ACCESS_SECRET=cambia-este-secreto-por-uno-de-al-menos-32-caracteres
JWT_ACCESS_MINUTES=15

# Administrador inicial para `npm run db:seed`.
ADMIN_EMAIL=admin@dyd.com
ADMIN_PASSWORD=cambia-esta-password

# Correo (opcional). Si falta SMTP_HOST/SMTP_USER/SMTP_PASS, las alertas por correo quedan desactivadas.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Datos de demostración (opcional, para `npx tsx --env-file=.env prisma/demo.ts`).
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
DEMO_TECNICO_PASSWORD=
