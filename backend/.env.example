# Copiá este archivo como .env para desarrollo en el host.
# Para Docker, usá .env.docker (DATABASE_URL y REDIS_URL apuntan a los servicios).

NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://root:postgres@localhost:5432/dyd_db?schema=public
REDIS_URL=redis://localhost:6379
# Mínimo 32 caracteres. Cambialo en producción.
JWT_ACCESS_SECRET=DyD_Sistema_Secreto_2026_Muy_Seguro_32chars
JWT_ACCESS_MINUTES=15

# Credenciales del seed (contraseñas de al menos 8 caracteres).
# Re-ejecutar `prisma/seed.ts` restablece estas contraseñas.
ADMIN_EMAIL=admin@dyd.com
ADMIN_PASSWORD=Admin1234
DEMO_TECNICO_EMAIL=tecnico@dyd.com
DEMO_TECNICO_PASSWORD=Tecnico1234
DEMO_CLIENTE_EMAIL=cliente@dyd.com
DEMO_CLIENTE_PASSWORD=Cliente1234
