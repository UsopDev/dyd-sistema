{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "mcp": {
    "filesystem": {
      "enabled": true,
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-filesystem",
        ".",
        "../frontend/"
      ]
    },

    "git": {
      "type": "local",
      "enabled": true,
      "command": ["uvx", "mcp-server-git", "--repository", "."]
    }
  }
}
