{
  "name": "dyd-backend",
  "version": "0.1.0",
  "description": "",
  "scripts": {
    "test": "vitest run --coverage",
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "node --env-file=.env node_modules/prisma/build/index.js generate",
    "db:migrate": "node --env-file=.env node_modules/prisma/build/index.js migrate dev",
    "db:studio": "node --env-file=.env node_modules/prisma/build/index.js studio",
    "db:validate": "node --env-file=.env node_modules/prisma/build/index.js validate",
    "db:seed": "tsx --env-file=.env prisma/seed.ts",
    "db:seed:docker": "docker compose exec backend npx tsx prisma/seed.ts",
    "db:seed:demo": "docker compose exec backend npx tsx prisma/seedDataDyD.ts",
    "db:deploy": "node --env-file=.env node_modules/prisma/build/index.js migrate deploy"
  },
  "keywords": [],
  "type": "module",
  "private": true,
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@types/pdfkit": "^0.17.7",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "2.5.0",
    "nodemailer": "^10.3.1",
    "openapi-types": "^12.1.3",
    "pdfkit": "^0.21.0",
    "pdfmake": "^0.3.15",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.19.4",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/pdfmake": "^0.3.5",
    "@types/swagger-ui-express": "^4.1.8",
    "@vitest/coverage-v8": "^5.1.2",
    "prisma": "^7.10.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.2"
  },
  "allowScripts": {
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true,
    "bcrypt@6.0.0": true
  }
}
