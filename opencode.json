{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "mcp": {
    "filesystem": {
      "enabled": true,
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-filesystem", "./"]
    },

    "git": {
      "enabled": true,
      "type": "local",
      "command": ["uvx", "mcp-server-git", "--repository", "."]
    }
  }
}
